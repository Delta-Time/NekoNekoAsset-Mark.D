{
  "name": "nekonekoasset",
  "private": true,
  "version": "0.4.0+D1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "bindings": "node ../scripts/bindings.mjs",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "node checks/run.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "native:test": "cargo test --manifest-path src-tauri/Cargo.toml --lib --locked",
    "native:dev": "tauri dev",
    "native:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
